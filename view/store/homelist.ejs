<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="./output.css" />
  <title>Document</title>
</head>

<body>
  <header style="display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; background-color: #1e293b; color: #f8fafc; border-radius: 8px; margin-bottom: 20px; font-family: sans-serif;">
    <span style="font-weight: 600; font-size: 1.1rem;">Welcome Here</span>
    <form action="/logout" method="POST" style="margin: 0;">
      <button type="submit" style="background: #ef4444; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: background 0.2s;">Logout</button>
    </form>
  </header>
  <main>

    <hr>
    <% homelist.forEach(function(home){%>
      <li>
        <%=home.homeaddress%>
          <br>
          
          <%=home.ownername%>
            <br>
             <a href="addfav/<%= home.id%>">Add To Fav</a>
             <br>
            <a href="/home/<%= home.id %>">Details</a>
            <hr>
      </li>
      <%})%>

        <h1>You are welcome Here</h1>
        <a href="add-home">Go to add Home</a>
        <br>
        <a href="favourates">Favourate list</a>
  </main>
</body>

</html>